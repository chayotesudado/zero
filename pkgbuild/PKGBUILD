# Not "zero": the AUR has an unrelated package by that name (a coding agent),
# and AUR helpers like yay, which Omarchy's update runs, take a local package
# for the AUR one of the same name and "upgrade" it to that. The command is
# still zero.
pkgname=zero-todoist
pkgver=0.3.4
pkgrel=1
pkgdesc='Todoist for Omarchy: today, upcoming, projects, and quick add from the keyboard'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
# Zero was called Ticked before, and its package was "zero" until 0.3.4.
# Anything else named zero also installs /usr/bin/zero, the AUR coding agent
# included, so pacman asks before one replaces the other.
conflicts=('ticked' 'zero')
replaces=('ticked')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/zero "$pkgdir/usr/bin/zero"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The pixel-art icon: drawn PNGs at each size, which stay sharp where a
  # scaled SVG would blur, the SVG for any other size, and a one-color Z.
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "$startdir/icons/zero-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/zero.png"
  done
  install -Dm644 "$startdir/zero.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/zero.svg"
  install -Dm644 "$startdir/zero-symbolic.svg" "$pkgdir/usr/share/icons/hicolor/symbolic/apps/zero-symbolic.svg"
  install -Dm644 "$startdir/zero.desktop" "$pkgdir/usr/share/applications/zero.desktop"
}
