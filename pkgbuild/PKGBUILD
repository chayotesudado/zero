pkgname=zero
pkgver=0.2.0
pkgrel=1
pkgdesc='Todoist for Omarchy: today, upcoming, projects, and quick add from the keyboard'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
# Zero was called Ticked before.
conflicts=('ticked')
replaces=('ticked')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/zero "$pkgdir/usr/bin/zero"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/zero.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/zero.svg"
  install -Dm644 "$startdir/zero.desktop" "$pkgdir/usr/share/applications/zero.desktop"
}
